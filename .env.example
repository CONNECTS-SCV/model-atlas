DATABASE_URL=postgresql://localhost:5432/curieus_atlas
# Required to call admin APIs; generate using: openssl rand -hex 32
ADMIN_TOKEN=
# Optional for public repositories; recommended to avoid anonymous rate limits
GITHUB_TOKEN=
SYNC_INTERVAL_HOURS=6
# PostgreSQL TLS: configure certificate trust in your connection string in production.

ENRICH_BATCH_SIZE=5
# Only needed by Docker Compose (set in .env, never commit):
POSTGRES_PASSWORD=

# Local Mac only: reuse gh's keychain login server-side; never exposed to browser.
GITHUB_USE_GH_AUTH=false
