{
  "name": "curieus-model-atlas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local .next/standalone/server.js",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "sync": "tsx --env-file-if-exists=.env.local scripts/worker.ts --once",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "enrich": "tsx --env-file-if-exists=.env.local scripts/worker.ts --enrich",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prestart": "node scripts/prepare-standalone.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "export:pages": "tsx --env-file-if-exists=.env.local scripts/export-pages.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.2",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "lucide-react": "^0.577.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@playwright/test": "^1.58.2"
  },
  "type": "module"
}
